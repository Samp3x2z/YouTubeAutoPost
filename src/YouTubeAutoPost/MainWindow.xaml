<Window
    x:Class="YouTubeAutoPost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="32" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="46"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="TitleBarDragRegion" Grid.Column="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image x:Name="TitleBarIcon" Width="16" Height="16" Stretch="Uniform"/>
                    <TextBlock Text="YouTube AutoPost" FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimary}"/>
                </StackPanel>
            </Grid>
            <Button Grid.Column="1" Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                    FontSize="10" Width="46" Height="32" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Click="MinimizeWindow_Click"/>
            <Button x:Name="CloseWindowButton" Grid.Column="2" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                    FontSize="10" Width="46" Height="32" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    PointerEntered="CloseWindowButton_PointerEntered"
                    PointerExited="CloseWindowButton_PointerExited"
                    Click="CloseWindow_Click"/>
        </Grid>

        <Grid x:Name="RootLayout" Grid.Row="1" Background="Transparent" Padding="22" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="YouTube AutoPost" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="ChannelText" Text="Compte Google / chaîne YouTube" Foreground="#929AA8"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="ImportOAuthButton" Content="Ajouter le JSON OAuth" Click="ImportOAuth_Click"/>
                <Button x:Name="ConnectButton" Content="Connecter" Click="Connect_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="MainContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8" Padding="0,4,8,8">
                <StackPanel Spacing="8">
                    <TextBlock Text="SOURCE DES VIDÉOS" FontSize="16" FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderTextBox" Grid.Column="0" IsReadOnly="True" PlaceholderText="Aucun dossier sélectionné"/>
                        <Button x:Name="BrowseFolderButton" Grid.Column="1" Content="Parcourir…" Click="BrowseFolder_Click"/>
                    </Grid>
                    <TextBlock Text="Les sous-dossiers sont inclus."
                               Foreground="#929AA8" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                        <TextBlock Text="PUBLICATION" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ToggleSwitch x:Name="AutoPublishToggle" OnContent="Automatique" OffContent="Manuel"
                                      IsOn="False" Toggled="AutoPublish_Toggled"/>
                    </StackPanel>
                    <TextBlock Text="Envoyer vers" FontWeight="SemiBold"/>

                    <ComboBox Width="250" x:Name="TargetModeCombo" SelectedIndex="0" SelectionChanged="TargetMode_Changed">
                        <ComboBoxItem Content="Ma chaîne"/>
                        <ComboBoxItem Content="Une playlist"/>
                    </ComboBox>
                    <ComboBox Width="250" x:Name="PlaylistCombo" PlaceholderText="Connecte-toi pour charger tes playlists"
                              IsEnabled="False" SelectionChanged="SettingsSelection_Changed"/>
                    <TextBlock Text="Visibilité des vidéos" FontWeight="SemiBold"/>

                    <ComboBox Width="250" x:Name="PrivacyCombo" SelectedIndex="1" SelectionChanged="SettingsSelection_Changed">
                        <ComboBoxItem Content="Publique" Tag="public"/>
                        <ComboBoxItem Content="Non répertoriée" Tag="unlisted"/>
                        <ComboBoxItem Content="Privée" Tag="private"/>
                    </ComboBox>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="LogsPanel" Grid.Row="1" RowSpacing="8" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="JOURNAL" FontSize="16" FontWeight="SemiBold"/>
            <ListView x:Name="LogList" Grid.Row="1" SelectionMode="None"
                      HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#454B55" BorderThickness="0,0,0,1" Padding="0,0,0,7" Margin="0,0,0,7">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextTrimming="None"/>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatusText" Text="Prêt."
                       HorizontalAlignment="Stretch" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap"/>
            <Grid Grid.Row="1" ColumnSpacing="11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="LogsToggleButton" Grid.Column="0" Content="Afficher les logs" Click="LogsToggle_Click"/>
                <Button x:Name="CleanButton" Grid.Column="2" Content="Nettoyer" Click="Clean_Click"/>
                <Button x:Name="SyncButton" Grid.Column="3" Content="Synchroniser" Style="{StaticResource AccentButtonStyle}" Click="Sync_Click"/>
                <Button x:Name="StopButton" Grid.Column="3" Content="Arrêter" Click="Stop_Click"
                        Visibility="Collapsed"/>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</Window>
